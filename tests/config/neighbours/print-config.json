{
  "linterOptions": {
    "reportUnusedDisableDirectives": 1
  },
  "rules": {
    "@typescript-eslint/no-floating-promises": [
      2
    ],
    "@typescript-eslint/await-thenable": [
      0
    ],
    "no-debugger": [
      2
    ],
    "no-console": [
      1,
      {}
    ],
    "no-alert": [
      0
    ]
  },
  "plugins": [
    "@",
    "@typescript-eslint:@typescript-eslint/eslint-plugin@8.62.0"
  ],
  "language": "@/js",
  "languageOptions": {
    "sourceType": "module",
    "ecmaVersion": 2026,
    "parser": "typescript-eslint/parser@8.62.0",
    "parserOptions": {
      "projectService": true,
      "tsconfigRootDir": "<tests/config>"
    }
  }
}
